# ------------------------------------------------------------
# Modelos locales: Ollama se ejecuta en el host, fuera de Docker
# ------------------------------------------------------------
OLLAMA_BASE_URL=http://172.29.67.74:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.2

# ------------------------------------------------------------
# Servicios internos de Docker Compose
# Los hostnames son los nombres de servicio de docker-compose.yml
# ------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=rtve_subtitles

MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=rtve-rag-local

# ------------------------------------------------------------
# LangSmith SaaS — P3: trazas completas
# Mantener desactivado hasta crear y pegar una NUEVA clave.
# No subir .env a Git.
# ------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=**************************************************
LANGSMITH_PROJECT=rtve-rag-local-dev
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_ENVIRONMENT=development
LANGSMITH_CONTENT_MODE=full
LANGSMITH_SAMPLE_RATE=1.0
# ------------------------------------------------------------
# Aplicación
# ------------------------------------------------------------
LOG_LEVEL=INFO
